# Uploaded media only — never execute anything from this tree.
# Admin uploads are MIME-validated and renamed on the way in; this is the
# second line of defence in case a file ever slips through.
Options -Indexes -ExecCGI

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(php|php\d*|phtml|phar|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
