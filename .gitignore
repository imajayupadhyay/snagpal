# Environment / secrets — never commit (every variant except the template)
.env
.env.*
!.env.example

# PHP session files
/storage/sessions/*
!/storage/sessions/.gitkeep

# Admin-uploaded media (user content)
# NOTE: this whole tree is also excluded from the deploy rsync, so anything
# kept here is for local dev only — the server copy is written by the
# Jenkins "Server Setup" stage.
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess
!/public/uploads/homepage/.gitkeep

# CI / deployment pipeline (kept out of the repo)
Jenkinsfile

# Logs
*.log

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
